            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 480000,\n  \"description\": \"Updated description with price drop\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}"]
            }
          }
        },
        {
