              "raw": "{\n  \"title\": \"Modern Apartment in Bole\",\n  \"description\": \"Spacious 2 bedroom apartment near airport\",\n  \"price\": 500000,\n  \"location\": \"Bole, Addis Ababa\",\n  \"images\": [\"https://res.cloudinary.com/demo/image/upload/sample.jpg\"]\n}"
            },
            "url": {
